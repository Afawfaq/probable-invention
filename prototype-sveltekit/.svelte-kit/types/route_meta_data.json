{
	"/": [
		"src/routes/+page.server.ts",
		"src/routes/+layout.ts",
		"src/routes/+layout.ts"
	],
	"/groups/[slug]": [
		"src/routes/groups/[slug]/+page.server.ts",
		"src/routes/groups/[slug]/+layout.server.ts",
		"src/routes/+layout.ts",
		"src/routes/groups/[slug]/+layout.server.ts",
		"src/routes/+layout.ts"
	],
	"/groups/[slug]/references": [
		"src/routes/groups/[slug]/references/+page.server.ts",
		"src/routes/groups/[slug]/+layout.server.ts",
		"src/routes/+layout.ts"
	],
	"/groups/[slug]/timeline": [
		"src/routes/groups/[slug]/timeline/+page.server.ts",
		"src/routes/groups/[slug]/+layout.server.ts",
		"src/routes/+layout.ts"
	],
	"/groups/[slug]/[section]/[item]": [
		"src/routes/groups/[slug]/[section]/[item]/+page.server.ts",
		"src/routes/groups/[slug]/+layout.server.ts",
		"src/routes/+layout.ts"
	]
}